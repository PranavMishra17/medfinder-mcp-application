# ════════════════════════════════════════════════════════════════════════════
#  Medfinder MCP Application Agent — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Lines starting with # are comments and are ignored.
# ════════════════════════════════════════════════════════════════════════════


# ── Agent behaviour ───────────────────────────────────────────────────────────
# Set to false when you are ready to actually submit. true = safe mode (no POST).
DRY_RUN=true

# Claude model used for screening-question reasoning.
# Options: claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6


# ── API keys ──────────────────────────────────────────────────────────────────
# Required. Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...


# ── Identity (required — submitted directly to the MCP) ──────────────────────
CANDIDATE_NAME=Pranav Mishra
CANDIDATE_EMAIL=your@email.com


# ── Profile links (required — submitted directly to the MCP) ─────────────────
# GitHub profile URL (not a repo — your profile root)
CANDIDATE_GITHUB=https://github.com/PranavMishra17

# LinkedIn profile URL
CANDIDATE_LINKEDIN=https://linkedin.com/in/pranavgamedev


# ── Resume (required — must be a publicly reachable URL) ─────────────────────
# Host your PDF on: GitHub Releases, your portfolio site, Google Drive (public link),
# Dropbox, or any CDN. The MCP server fetches it directly.
CANDIDATE_RESUME_URL=https://your-portfolio.vercel.app/resume.pdf

# Mime type of the resume file. Almost always application/pdf.
# Other accepted values: application/msword | application/vnd.openxmlformats-officedocument.wordprocessingml.document
CANDIDATE_RESUME_MIME_TYPE=application/pdf


# ── Primary agentic project (required — the "OpenClaw / agent harness" field) ─
# Link to your most impressive autonomous-agent project.
# Best options for this role:
#   - MockFlow-AI live URL (production voice AI + agentic pipeline)
#   - alfred_ execution layer (Next.js + Claude autonomous orchestration)
#   - SoulEngine GitHub repo (TypeScript NPC agent framework)
#   - A GitHub repo with a clear README that shows the agent loop
CANDIDATE_PROJECT_URL=https://mockflow-ai.onrender.com


# ── Contact & location (used to build Claude's reasoning context) ─────────────
CANDIDATE_PHONE=+1-312-000-0000
CANDIDATE_LOCATION=Chicago, IL (willing to relocate to Boston)
CANDIDATE_PORTFOLIO=https://portfolio-pranav-mishra-paranoid.vercel.app


# ── Current role (used for bio context) ──────────────────────────────────────
CANDIDATE_CURRENT_ROLE=AI Engineer
CANDIDATE_CURRENT_COMPANY=WheelPrice (Techstars-backed automotive startup)
CANDIDATE_CURRENT_ROLE_SUMMARY=Computer vision pipeline for automotive inventory — YOLOv8n, DeepLabV3+, homography, AWS EC2/ECS/DynamoDB


# ── Education (used for bio context) ─────────────────────────────────────────
CANDIDATE_EDUCATION=MS Computer Science — University of Illinois Chicago (UIC), May 2025


# ── Research & publications ───────────────────────────────────────────────────
# Format: Title|Venue|Year|URL  — separate multiple entries with double semicolons ;;
# Leave URL blank if not yet published publicly (use a preprint link if available)
CANDIDATE_PAPERS=MetaRAG|IEEE CAI|2026|https://arxiv.org/...;;TeamMedAgents|ICML|2026|https://arxiv.org/...


# ── Additional projects (for bio context, not submitted as the primary project) ─
# Format: Name|URL|One-line description — separate with double semicolons ;;
CANDIDATE_PROJECTS_EXTRA=SoulEngine|https://github.com/PranavMishra17/SoulEngine|TypeScript NPC intelligence framework — Deepgram+Cartesia voice, STM/LTM memory, MCP tools, multi-provider LLM;;alfred_|https://alfred.vercel.app|Autonomous execution decision layer — Next.js 14 + Claude Sonnet;;Flow Planner|https://github.com/PranavMishra17/FlowPlanner|Browser-Use + Gemini autonomous workflow capture;;Cloud VM Intelligence Cockpit|https://your-cockpit.vercel.app|XGBoost/IsolationForest/LightGBM anomaly detection + FastAPI/DuckDB/Redis;;SnakeAI|https://github.com/PranavMishra17/SnakeAI|C++ LibTorch + SFML — Q-Learning, DQN, PPO, Actor-Critic


# ── Voice AI experience (directly relevant — highlighted in reasoning context) ─
# Free text. Be specific about the stack and what's running in production.
CANDIDATE_VOICE_AI_SUMMARY=MockFlow-AI: production voice interview platform on Render — LiveKit Agents SDK, Deepgram STT, OpenAI TTS, Flask, Supabase, BYOK architecture; full STT→LLM→TTS pipeline with real users. SoulEngine: Deepgram + Cartesia voice stack embedded in a TypeScript NPC agent framework, shipped and being packaged for Unity Asset Store. Voice call center self-improving AI agent POC: ElevenLabs Conversational AI + Gemini 2.0 Flash + n8n + LLM-as-Judge improvement loop.


# ── Skills (used for bio context) ────────────────────────────────────────────
# Comma-separated. Keep it tight — most relevant first.
CANDIDATE_SKILLS=Python, TypeScript, C++, PyTorch, LangChain, LiveKit Agents SDK, Deepgram, OpenAI SDK, Anthropic SDK, AWS (EC2/ECS/DynamoDB), Docker, FastAPI, Flask, Next.js 14, Supabase, Unity, Unreal Engine, YOLOv8, XGBoost


# ── Hackathons & notable achievements (used for bio context) ──────────────────
# Format: Event|Result|Project — separate with double semicolons ;;
CANDIDATE_ACHIEVEMENTS=MIT Reality Hack 2025|Shipped|Hover Help — XR remote cooking assistant, Samsung Galaxy XR, Unity 6, WebRTC, hand tracking;;Kaggle Gemma 4 Good Hackathon|Top recommendation|ASHAsaathi — offline multimodal ASHA worker assistant, Gemma 4 + Indic stack;;Google Play Store||Multiple shipped Android games;;CAVE2 VR||NASA dataset visualizations for 320-degree immersive environment


# ── Candidate pitch / cover statement (optional free text) ────────────────────
# Claude uses this when constructing answers to open-ended screening questions.
# Write 2-5 sentences about why you're a fit for this specific role.
CANDIDATE_PITCH=I've been building production agentic systems — not demos — for the past two years. MockFlow-AI is a live STT→LLM→TTS pipeline with real users. SoulEngine ships as a Unity package with a full agent memory + tool-use loop. I think in self-improving loops, not one-shot completions, which is exactly the pattern Medfinder describes. Boston works; building in person is how I do my best work.
